# Caddy owns the public 443 again. The tunnel is not a separate service on a
# separate port: it is one secret path on the application host, reverse proxied
# to Xray over WebSocket. Everything an observer can see is ordinary HTTPS to an
# ordinary site with a real certificate, because that is exactly what it is.
{
	admin off
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA}
}

app.{$BASE_DOMAIN} {
	# The tunnel. `handle` blocks are mutually exclusive and evaluated in source
	# order, so this one has to precede the catch-all that serves the Mini App.
	# Compression stays off here: the payload is already encrypted, and Caddy
	# must not buffer a long lived stream.
	handle {$WEBSOCKET_PATH} {
		reverse_proxy xray:2096
	}

	encode zstd gzip

	reverse_proxy app:3000 {
		health_uri /readyz
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format json
	}
}

# Only the subscription paths reach Marzban here. `handle` blocks are mutually
# exclusive and evaluated in source order, unlike bare directives: Caddy sorts
# those by its own directive order, where `respond` precedes `reverse_proxy`,
# so a trailing catch-all `respond` silently swallows every proxied route.
sub.{$BASE_DOMAIN} {
	handle /sub/* {
		reverse_proxy unix//run/marzban/uvicorn.sock
	}

	# Default deny: the dashboard, the API and the docs are never exposed here.
	handle {
		respond 404
	}
}

# Private Marzban API for the application. Reachable only inside the internal
# `backend` network, where this proxy answers to the `marzban` alias.
:8000 {
	reverse_proxy unix//run/marzban/uvicorn.sock
}
