{
	admin off
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA}
}

app.{$BASE_DOMAIN} {
	encode zstd gzip

	reverse_proxy app:3000 {
		health_uri /readyz
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format json
	}
}

sub.{$BASE_DOMAIN} {
	@denied path /api/* /dashboard/* /docs* /openapi.json /redoc*
	respond @denied 404

	@subscription path /sub/*
	reverse_proxy @subscription unix//run/marzban/uvicorn.sock

	respond 404
}

# Private Marzban API for the application. Reachable only inside the internal
# `backend` network, where this proxy answers to the `marzban` alias.
:8000 {
	reverse_proxy unix//run/marzban/uvicorn.sock
}
