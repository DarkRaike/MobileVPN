# Xray owns the public 443 — the only port that reaches this server from every
# network — and hands Caddy every connection it does not authenticate. Caddy
# still listens on 443 inside its own container and simply publishes no port, so
# redirects, ACME and site addresses keep their standard shape.
#
# Port 80 stays published for the ACME HTTP-01 challenge. TLS-ALPN-01 is refused
# explicitly: it would have to answer on the public 443, which Xray holds, and
# Caddy would otherwise keep retrying a challenge that cannot succeed.
{
	admin off

	cert_issuer acme {$ACME_CA} {
		email {$ACME_EMAIL}
		disable_tlsalpn_challenge
	}
}

app.{$BASE_DOMAIN} {
	encode zstd gzip

	reverse_proxy app:3000 {
		health_uri /readyz
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format json
	}
}

# Only the subscription paths reach Marzban here. `handle` blocks are mutually
# exclusive and evaluated in source order, unlike bare directives: Caddy sorts
# those by its own directive order, where `respond` precedes `reverse_proxy`,
# so a trailing catch-all `respond` silently swallows every proxied route.
sub.{$BASE_DOMAIN} {
	handle /sub/* {
		reverse_proxy unix//run/marzban/uvicorn.sock
	}

	# Default deny: the dashboard, the API and the docs are never exposed here.
	handle {
		respond 404
	}
}

# Private Marzban API for the application. Reachable only inside the internal
# `backend` network, where this proxy answers to the `marzban` alias.
:8000 {
	reverse_proxy unix//run/marzban/uvicorn.sock
}
