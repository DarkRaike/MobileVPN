# Single stack configuration. Copy to deployment/production.env and fill in the
# operator owned values below. Session, monitoring, webhook, Marzban and REALITY
# secrets are generated by the bootstrap service and never belong in this file.

# Tag applied to the locally built application and operations images.
RELEASE_VERSION=0.1.0

# Placeholder domain: replace it with the domain owned by the project.
# app.<domain>  - Mini App and POST /api/telegram/webhook
# sub.<domain>  - Marzban /sub/* only
# vpn.<domain>  - VLESS REALITY endpoint on VLESS_PORT
BASE_DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Uncomment while the domain is still a placeholder to avoid Let's Encrypt
# production rate limits. Certificates will not be issued without real DNS.
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
ALERT_TELEGRAM_CHAT_ID=

# Real payments and real VPN provisioning stay closed until every gate in
# docs/operations/production-readiness.md is backed by evidence.
ENABLE_LIVE_OPERATIONS=false

MARZBAN_USERNAME=astra_admin
MARZBAN_VLESS_INBOUND_TAG=VLESS_TCP_REALITY_V1

# The REALITY target must support TLS 1.3, match the SNI list, and negotiate a
# classic X25519 key exchange. A target that selects a post-quantum hybrid such
# as X25519MLKEM768 breaks the pinned Xray build: outsiders still reach the
# masquerade site, but authenticated clients are disconnected during the
# handshake. `xray tls ping` does not detect this - see the measurement command
# in docs/operations/vps-deployment.md.
#
# Re-measure before every release: a target that negotiated classic X25519 can
# start selecting the hybrid at any time, and the whole service goes down with
# no error anywhere.
REALITY_DEST=www.nvidia.com:443
REALITY_SERVER_NAMES=www.nvidia.com
VLESS_PORT=8443

# Address written into every client configuration. Defaults to vpn.<BASE_DOMAIN>,
# which must be an A record without proxying. Set the VPS IP here only to unblock
# a deployment whose `vpn` record is not usable yet: an IP has to be reissued to
# every subscriber when the server moves.
# REALITY_ENDPOINT_HOST=

# Xray error log level: debug, info, warning, error, none. A rejected REALITY
# handshake is only reported below `warning`, so raise this to `info` while
# diagnosing a client that cannot connect. Access logging stays off.
XRAY_LOG_LEVEL=warning

# REALITY prints why it refused each handshake when this is on. A rejected
# client is otherwise logged as `processed invalid connection` whether it sent
# the wrong short ID or a ClientHello this build cannot parse. One block per
# connection, so keep it off outside a diagnosis.
REALITY_SHOW=false

RECONCILIATION_INTERVAL_MILLISECONDS=30000
MONITORING_INTERVAL_MILLISECONDS=60000
ALERT_REPEAT_MILLISECONDS=1800000

# Host directory holding the generated secrets. Keep it out of Git and back it
# up encrypted; losing it invalidates every issued subscription URL.
DEPLOY_SECRET_DIRECTORY=./secrets
APP_UID=1000
APP_GID=1000

# Enable the hourly restic backup after deployment/backup.env is configured.
# COMPOSE_PROFILES=backup
