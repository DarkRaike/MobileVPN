# Reference only. deployment/bootstrap/bootstrap.py writes the real marzban.env
# into DEPLOY_SECRET_DIRECTORY on every stack start. SUDO_USERNAME and
# SUDO_PASSWORD are added only to marzban-init.env, which the one-shot admin
# import service consumes.
DEBUG=False
DOCS=False
SQLALCHEMY_DATABASE_URL=sqlite:////var/lib/marzban/db.sqlite3
UVICORN_UDS=/run/marzban/uvicorn.sock
XRAY_JSON=/run/astra/secrets/xray_config.json
XRAY_SUBSCRIPTION_PATH=sub
XRAY_SUBSCRIPTION_URL_PREFIX=
