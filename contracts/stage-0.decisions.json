{
  "contractVersion": "1.1.0",
  "stage": 0,
  "reviewedAt": "2026-07-27",
  "implementationStatus": "approved_for_implementation",
  "productionReady": true,
  "design": {
    "source": "vpn-mini-app.html",
    "productName": "Astra VPN",
    "fontFamily": "Inter, system-ui, sans-serif",
    "colors": {
      "app": "#151616",
      "card": "#202121",
      "accent": "#4d96ff",
      "muted": "#8b8d91"
    },
    "style": ["dark", "rounded_cards", "subtle_glass"]
  },
  "product": {
    "currency": "XTR",
    "trafficLimitBytes": 0,
    "devicePolicy": {
      "limit": 3,
      "enforcement": "soft_personal_use_policy",
      "reason": "Marzban v0.8.4 does not provide a reliable hard concurrent-device limit"
    },
    "plans": [
      {
        "durationDays": 7,
        "priceStars": 99
      },
      {
        "durationDays": 30,
        "priceStars": 249
      },
      {
        "durationDays": 90,
        "priceStars": 599
      }
    ],
    "renewal": {
      "sequentialPurchasesAllowed": true,
      "maximumSalesHorizonDays": 365,
      "expiresAtFormula": "max(actualMarzbanExpire, localExpire, paidAt) + durationDays",
      "applyEachOrderExactlyOnce": true
    },
    "promoCode": {
      "clientPersistence": "sessionStorage",
      "serverRevalidationRequired": true,
      "emptyPlanAllowlistMeansAllPlans": true
    }
  },
  "payments": {
    "provider": "telegram_stars",
    "providerDisplayName": "Telegram Stars",
    "currency": "XTR",
    "moneyStorage": "integer_stars",
    "flow": "one_time_mini_app_invoice",
    "recurringPayments": false,
    "paymentMethods": ["telegram_stars"],
    "futureExternalPayments": {
      "status": "out_of_scope_for_v1",
      "rule": "Select and contract-test a new provider in a separate stage before adding non-Telegram sales"
    },
    "api": {
      "documentedBotApiVersion": "10.2",
      "baseUrlTemplate": "https://api.telegram.org/bot{token}",
      "createInvoiceLink": {
        "method": "POST",
        "path": "/createInvoiceLink"
      },
      "answerPreCheckoutQuery": {
        "method": "POST",
        "path": "/answerPreCheckoutQuery"
      },
      "refundStarPayment": {
        "method": "POST",
        "path": "/refundStarPayment"
      },
      "getStarTransactions": {
        "method": "POST",
        "path": "/getStarTransactions"
      }
    },
    "invoice": {
      "method": "createInvoiceLink",
      "providerToken": "empty_string",
      "currency": "XTR",
      "pricesExactlyOneItem": true,
      "payload": "v1:{opaqueLocalPaymentAttemptId}",
      "payloadMaximumBytes": 128,
      "amountSource": "server_calculated_integer_stars",
      "collectPersonalData": false,
      "openMethod": "Telegram.WebApp.openInvoice",
      "minimumWebAppVersion": "6.1",
      "openOnlyOnDirectUserAction": true
    },
    "miniAppCallback": {
      "statuses": ["paid", "cancelled", "failed", "pending"],
      "purpose": "user_experience_only",
      "confirmsPayment": false
    },
    "webhook": {
      "path": "/api/telegram/webhook",
      "contentType": "application/json",
      "secretHeader": "X-Telegram-Bot-Api-Secret-Token",
      "secretEnvironmentVariable": "TELEGRAM_WEBHOOK_SECRET",
      "maximumBodyBytes": 65536,
      "rateLimited": true,
      "allowedUpdates": ["message", "pre_checkout_query"],
      "preCheckout": {
        "telegramDeadlineSeconds": 10,
        "internalDeadlineSeconds": 8,
        "requiredMatches": [
          "from.id",
          "invoice_payload",
          "currency=XTR",
          "total_amount"
        ],
        "answerMethod": "answerPreCheckoutQuery"
      },
      "authoritativeConfirmation": {
        "source": "message.successful_payment",
        "requiredMatches": [
          "message.from.id",
          "invoice_payload",
          "currency=XTR",
          "total_amount",
          "telegram_payment_charge_id"
        ]
      },
      "deduplication": ["update_id", "telegram_payment_charge_id"],
      "preCheckoutApprovalConfirmsPayment": false,
      "provisioningInResponsePath": false
    },
    "reconciliation": {
      "method": "getStarTransactions",
      "telegramUpdateRetentionHours": 24,
      "requiredMatches": [
        "transaction.id",
        "source.invoice_payload",
        "source.user.id",
        "amount"
      ]
    },
    "refunds": {
      "versionOneFlow": "bot_api_full_refund",
      "initiation": "admin_only",
      "method": "refundStarPayment",
      "requiredInput": ["user_id", "telegram_payment_charge_id"],
      "partialRefunds": false,
      "stateFlow": [
        "refund_requested",
        "refund_pending",
        "refunded_or_refund_failed"
      ],
      "accessAction": "revoke only after provider refund confirmation without truncating access purchased by other orders",
      "evidenceRequired": true,
      "customerRequestChannel": "/paysupport"
    },
    "customerProtection": {
      "requiredCommands": ["/terms", "/paysupport"],
      "termsAcceptanceBeforeInvoice": true,
      "merchantHandlesDisputes": true,
      "taxAndAccountingReviewRequired": true
    }
  },
  "domains": {
    "baseDomain": "vpn-service.fun",
    "templates": {
      "application": "app.{baseDomain}",
      "subscription": "sub.{baseDomain}",
      "reality": "vpn.{baseDomain}"
    },
    "publicAdminDomain": null,
    "marzbanAdminAccess": "SSH tunnel only",
    "dnsProxying": "DNS only for the REALITY endpoint"
  },
  "reverseProxy": {
    "provider": "caddy",
    "image": "caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648",
    "publicPorts": [80, 443],
    "restrictedPorts": [
      {
        "port": 22,
        "access": "operator IP allowlist"
      }
    ],
    "privatePorts": [
      {
        "service": "app",
        "port": 3000
      },
      {
        "service": "marzban",
        "port": 8000
      },
      {
        "service": "caddy_admin",
        "port": 2019
      }
    ],
    "routes": [
      {
        "hostTemplate": "app.{baseDomain}",
        "path": "/*",
        "upstream": "app:3000"
      },
      {
        "hostTemplate": "sub.{baseDomain}",
        "path": "/sub/*",
        "upstream": "marzban:8000"
      }
    ],
    "subscriptionHostDeniedPaths": [
      "/api/*",
      "/dashboard/*",
      "/docs",
      "/openapi.json"
    ],
    "subscriptionAccessLogs": false
  },
  "marzban": {
    "version": "0.8.4",
    "tag": "v0.8.4",
    "commit": "7f396db3e703d71a28060bc9ce4a532ec64cb1f4",
    "image": "gozargah/marzban:v0.8.4@sha256:8e422c21997e5d2e3fa231eeff73c0a19193c20fc02fa4958e9368abb9623b8d",
    "openapi": {
      "file": "contracts/marzban/openapi.v0.8.4.json",
      "sha256": "1f38142daa8a4b636ed11b16e9511583df81cc5373db964f88fd94206f1608dc",
      "infoVersion": "0.8.4"
    },
    "authentication": {
      "tokenEndpoint": "POST /api/admin/token",
      "scheme": "OAuth2 password form and Bearer token"
    },
    "adapterOperations": [
      "POST /api/admin/token",
      "GET /api/user/{username}",
      "POST /api/user",
      "PUT /api/user/{username}"
    ],
    "apiNetwork": "private Docker network only",
    "docsEnabledInProduction": false,
    "securityReview": {
      "required": true,
      "reason": "The selected stable release is old and must pass image, dependency and bundled Xray vulnerability review"
    }
  },
  "vless": {
    "protocol": "vless",
    "inboundTag": "VLESS TCP REALITY",
    "listen": "0.0.0.0",
    "port": 443,
    "transport": "raw_tcp",
    "security": "reality",
    "flow": "",
    "flowDecision": "plain VLESS; xtls-rprx-vision authenticates and then carries no traffic between the pinned Xray 24.12.31 and the cores current mobile clients ship",
    "decryption": "none",
    "trafficLimitBytes": 0,
    "resetStrategy": "no_reset",
    "reality": {
      "target": "gateway.icloud.com:443",
      "serverNames": ["gateway.icloud.com"],
      "privateKeyStorage": "secret file outside the repository",
      "shortIdPattern": "^[0-9a-f]{16}$",
      "targetSelection": "require TLS 1.3, a matching SAN, and a classic X25519 key exchange; a target that selects a post-quantum hybrid such as X25519MLKEM768 disconnects authenticated clients on the pinned Xray build",
      "keyExchangeConstraint": "classic X25519 only",
      "measurementExpires": "a target can start selecting the hybrid at any time; re-measure before every release",
      "lastMeasuredAt": "2026-08-01",
      "rejectedTargets": [
        {
          "target": "www.microsoft.com:443",
          "reason": "selects X25519MLKEM768, which the pinned Xray build cannot intercept"
        },
        {
          "target": "www.swift.com:443",
          "reason": "measured classic on 2026-08-01 and selecting X25519MLKEM768 the same day; ran in production and disconnected every authenticated client"
        },
        {
          "target": "www.samsung.com:443",
          "reason": "recorded as classic on 2026-08-01, re-measured the same day as X25519MLKEM768"
        },
        {
          "target": "gateway.icloud.com:443",
          "reason": "selects X25519MLKEM768"
        },
        {
          "target": "dl.google.com:443",
          "reason": "selects X25519MLKEM768"
        }
      ],
      "timeSynchronizationRequired": true
    }
  },
  "dataRetention": {
    "timezone": "UTC",
    "legalHoldOverridesDeletion": true,
    "dailyIdempotentPurge": true,
    "policies": [
      {
        "data": "active sessions",
        "retention": "7 days absolute and 24 hours idle"
      },
      {
        "data": "revoked or expired sessions",
        "retention": "30 days"
      },
      {
        "data": "users without purchase history",
        "retention": "delete after 12 months inactive"
      },
      {
        "data": "direct Telegram identifiers for users with purchase history",
        "retention": "anonymize after 24 months inactive unless legally required"
      },
      {
        "data": "Subscription URL",
        "retention": "active subscription plus 30 days"
      },
      {
        "data": "expired Marzban user",
        "retention": "30 days"
      },
      {
        "data": "support message body",
        "retention": "180 days after resolution"
      },
      {
        "data": "support delivery metadata",
        "retention": "1 year"
      },
      {
        "data": "admin audit log",
        "retention": "1 year"
      },
      {
        "data": "application and security logs",
        "retention": "30 days with redaction"
      },
      {
        "data": "Xray error logs",
        "retention": "7 days; access logs disabled"
      },
      {
        "data": "orders, payments, refunds and receipts",
        "retention": "set by approved accounting and legal schedule before production"
      }
    ]
  },
  "backup": {
    "rpoMinutes": 60,
    "rtoMinutes": 240,
    "tool": "restic",
    "encryption": "restic repository encryption with key stored outside the VPS",
    "offsite": "different provider, account and region",
    "objectLockGovernanceDays": 7,
    "sqliteMethod": "SQLite online backup API or .backup; never copy a live WAL database",
    "frequency": "hourly",
    "retention": {
      "hourlyHours": 48,
      "dailyDays": 30,
      "weeklyWeeks": 12,
      "maximumDays": 84
    },
    "verification": [
      "PRAGMA integrity_check",
      "PRAGMA foreign_key_check",
      "SHA-256 manifest"
    ],
    "alertAfterMinutesWithoutSuccessfulBackup": 65,
    "restoreDrill": "before production and quarterly in a disposable clean environment",
    "restoreOverLiveVolume": false
  },
  "delivery": {
    "continuousIntegration": "GitHub Actions",
    "continuousDelivery": false,
    "stagingEnvironment": false,
    "contractTestsUseNetwork": false
  },
  "productionReadiness": {
    "requiredGateIds": [
      "base_domain_dns",
      "telegram_webhook_secret",
      "telegram_stars_live_smoke",
      "bot_owner_2fa",
      "terms_and_paysupport",
      "merchant_legal_status",
      "tax_accounting_review",
      "legal_review",
      "reality_target",
      "reality_keys",
      "marzban_security_review",
      "offsite_backup",
      "restore_drill",
      "telegram_client_smoke",
      "team_lead_review"
    ],
    "gates": {
      "base_domain_dns": true,
      "telegram_webhook_secret": true,
      "telegram_stars_live_smoke": true,
      "bot_owner_2fa": true,
      "terms_and_paysupport": true,
      "merchant_legal_status": true,
      "tax_accounting_review": true,
      "legal_review": true,
      "reality_target": true,
      "reality_keys": true,
      "marzban_security_review": true,
      "offsite_backup": true,
      "restore_drill": true,
      "telegram_client_smoke": true,
      "team_lead_review": true
    }
  },
  "references": {
    "telegramStarsPayments": "https://core.telegram.org/bots/payments-stars",
    "telegramBotApi": "https://core.telegram.org/bots/api",
    "telegramCreateInvoiceLink": "https://core.telegram.org/bots/api#createinvoicelink",
    "telegramSuccessfulPayment": "https://core.telegram.org/bots/api#successfulpayment",
    "telegramRefundStarPayment": "https://core.telegram.org/bots/api#refundstarpayment",
    "telegramMiniAppOpenInvoice": "https://core.telegram.org/bots/webapps#initializing-mini-apps",
    "marzbanRelease": "https://github.com/Gozargah/Marzban/releases/tag/v0.8.4",
    "marzbanApi": "https://gozargah.github.io/marzban/en/docs/api",
    "reality": "https://xtls.github.io/en/config/transports/reality.html",
    "sqliteBackup": "https://www.sqlite.org/backup.html",
    "sqliteWal": "https://www.sqlite.org/wal.html",
    "resticEncryption": "https://restic.readthedocs.io/en/stable/070_encryption.html"
  },
